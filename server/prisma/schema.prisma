generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
  output     = "../libs/prisma/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["unidesk"]
}

model unidesk_users {
  user_id String @id @db.Uuid

  full_name  String
  email      String  @unique
  role       String // super-admin, sales, implementation, support
  password   String
  avatar_url String?

  created_at DateTime @default(now())
  updated_at DateTime
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  comments   String?

  @@schema("unidesk")
}

model schools {
  school_id   String    @id @db.Uuid
  school_code String    @unique
  name        String
  address     String?
  phone       String?
  email       String
  website     String?
  established DateTime?
  config      Json?
  created_at  DateTime  @default(now())
  created_by  String?
  updated_at  DateTime
  updated_by  String?
  is_active   Boolean   @default(true)
  is_deleted  Boolean   @default(false)
  comments    String?

  // Relations

  demo_requests              demo_requests[]
  school_pricing_plans       school_pricing_plans[]
  school_subscription_status school_subscription_status[]
  users                      users[]
  school_branding            school_branding?
  school_settings            school_settings[]
  school_initial_setup       school_initial_setup?
  roles                      roles[]
  // activity_logs          activity_logs[]
  // academic_years         academic_years[]
  // period_templates       period_templates[]
  // timetables             timetables[]
  // attendance_sessions    attendance_sessions[]
  // attendance_batch_imports attendance_batch_imports[]
  // attendance_insights    attendance_insights[]
  // attendance_ai_jobs     attendance_ai_jobs[]
  // exam_types             exam_types[]
  // exam_groups            exam_groups[]
  // assignments            assignments[]
  // question_bank          question_bank[]
  // study_materials        study_materials[]
  // doubts                 doubts[]
  // ai_learning_paths      ai_learning_paths[]
  // ai_learning_jobs       ai_learning_jobs[]
  // weekly_plans           weekly_plans[]
  // lesson_plan_templates  lesson_plan_templates[]
  // fee_categories         fee_categories[]
  // fee_items              fee_items[]
  // fee_structures         fee_structures[]
  // student_fee_assignments student_fee_assignments[]
  // fee_invoices           fee_invoices[]
  // fee_discounts          fee_discounts[]
  // payment_methods        payment_methods[]
  // fee_notifications      fee_notifications[]
  // transport_vehicles     transport_vehicles[]
  // transport_drivers      transport_drivers[]
  // transport_routes       transport_routes[]
  // vehicle_route_assignments vehicle_route_assignments[]
  // transport_events       transport_events[]
  // inventory_categories   inventory_categories[]
  // inventory_items        inventory_items[]
  // inventory_vendors      inventory_vendors[]
  // purchase_orders        purchase_orders[]
  // stock_master           stock_master[]
  // issue_requests         issue_requests[]
  // stock_audits           stock_audits[]
  // books                  books[]
  // library_members        library_members[]
  // announcements          announcements[]
  // notifications          notifications[]
  // ai_notification_summaries ai_notification_summaries[]
  // ptm_events             ptm_events[]
  // conversations          conversations[]
  // event_groups           event_groups[]
  // events                 events[]
  // school_calendars       school_calendars[]
  // leave_types            leave_types[]
  // leave_requests         leave_requests[]
  // media_albums           media_albums[]
  // media_items            media_items[]
  // media_tags             media_tags[]
  // media_upload_sessions  media_upload_sessions[]
  // media_settings         media_settings?
  // online_class_providers online_class_providers[]
  // online_classes         online_classes[]
  // class_sessions         class_sessions[]
  // import_jobs            import_jobs[]
  // export_jobs            export_jobs[]
  // report_definitions     report_definitions[]
  // ai_report_jobs         ai_report_jobs[]
  // feature_flags          feature_flags[]
  // communication_templates communication_templates[]
  // ai_template_jobs       ai_template_jobs[]

  @@schema("unidesk")
}

model school_subscription_status {
  status_id  String    @id @db.Uuid
  school_id  String    @db.Uuid
  status     String // "trial", "active", "inactive", "suspended"
  valid_from DateTime
  valid_to   DateTime?
  reason     String? // For suspended/inactive

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime
  updated_by String?
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  comments   String?

  school schools @relation(fields: [school_id], references: [school_id])

  @@index([school_id])
  @@schema("unidesk")
}

model school_pricing_plans {
  plan_id   String @id @db.Uuid
  school_id String @db.Uuid

  plan_type       String // "standard", "pro", "enterprise", "custom"
  price_per_month Float?
  billing_cycle   String? // monthly, yearly
  features        Json? // feature flags
  custom_notes    String? // for custom plans

  valid_from DateTime
  valid_to   DateTime?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime
  updated_by String?
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  comments   String?

  school schools @relation(fields: [school_id], references: [school_id])

  @@index([school_id])
  @@schema("unidesk")
}

model school_branding {
  branding_id          String   @id @db.Uuid
  school_id            String?  @unique @db.Uuid
  logo_url             String?
  banner_url           String?
  primary_color        String?
  secondary_color      String?
  accent_color         String?
  theme_mode           String?
  login_screen_config  Json?
  header_footer_config Json?
  created_at           DateTime
  created_by           String?
  updated_at           DateTime
  updated_by           String?
  is_active            Boolean  @default(true)
  is_deleted           Boolean  @default(false)
  comments             String?

  school schools? @relation(fields: [school_id], references: [school_id])

  @@schema("unidesk")
}

model school_settings {
  setting_id  String   @id @db.Uuid
  school_id   String?  @db.Uuid
  category    String?
  key         String?
  value       Json?
  description String?
  created_at  DateTime
  created_by  String?
  updated_at  DateTime
  updated_by  String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  comments    String?

  school schools? @relation(fields: [school_id], references: [school_id])

  @@unique([school_id, category, key])
  @@schema("unidesk")
}

model school_initial_setup {
  setup_id  String @id @db.Uuid
  school_id String @db.Uuid

  is_completed    Boolean @default(false)
  steps_completed Json?
  setup_version   Int     @default(1)

  completed_at DateTime?

  created_at DateTime
  created_by String?
  updated_at DateTime
  updated_by String?

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  school schools @relation(fields: [school_id], references: [school_id], onDelete: Cascade)

  @@unique([school_id])
  @@schema("unidesk")
}

model demo_requests {
  request_id String  @id @db.Uuid
  school_id  String? @db.Uuid

  organization      String
  organization_size String
  full_name         String
  contact_email     String
  contact_phone     String?
  country           String?
  city              String?

  message String?
  source  String?

  status String @default("new")

  scheduled_demo_at DateTime?

  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime
  comments   String?

  school schools? @relation(fields: [school_id], references: [school_id])

  @@index([contact_email])
  @@index([status])
  @@schema("unidesk")
}

model users {
  user_id           String    @id @db.Uuid
  school_id         String?   @db.Uuid
  user_code         String    @unique
  name              String?
  email             String?
  phone             String?
  password_hash     String?
  status            String?
  last_login_at     DateTime?
  profile_photo_url String?
  config            Json?
  created_by        String?
  updated_by        String?
  is_active         Boolean   @default(true)
  is_deleted        Boolean   @default(false)
  comments          String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())

  // Relations
  school                 schools?                @relation(fields: [school_id], references: [school_id])
  user_roles             user_roles[]
  user_preferences       user_preferences?
  user_onboarding_status user_onboarding_status?
  // auth_tokens  auth_tokens[]
  // otp          otp[]
  // activity_logs activity_logs[]
  // doubt_replies doubt_replies[]
  // assignment_comments assignment_comments[]
  // fcm_tokens   fcm_tokens[]
  // notification_logs notification_logs[]
  // presence     presence?
  // messages_sent messages[] @relation("MessageSender")
  // ptm_notes_teacher ptm_notes[] @relation("PTMNotesTeacher")
  // ptm_bookings_parent ptm_bookings[] @relation("PTMParent")
  // student_profiles student_profiles?
  // teacher_profiles teacher_profiles?
  // parent_profiles parent_profiles?
  authTokens             auth_tokens[]

  @@schema("unidesk")
}

model user_onboarding_status {
  onboarding_id      String    @id @db.Uuid
  user_id            String    @unique @db.Uuid
  has_completed      Boolean   @default(false)
  steps_completed    Json?
  onboarding_version Int?      @default(1)
  first_login_at     DateTime?
  last_prompt_at     DateTime?
  created_at         DateTime
  created_by         String?
  updated_at         DateTime
  updated_by         String?
  is_active          Boolean   @default(true)
  is_deleted         Boolean   @default(false)
  comments           String?

  user users? @relation(fields: [user_id], references: [user_id])

  @@schema("unidesk")
}

model user_preferences {
  pref_id               String   @id @db.Uuid
  user_id               String   @unique @db.Uuid
  theme                 String?
  language              String?
  dashboard_config      Json?
  shortcuts             Json?
  notification_settings Json?
  default_page          String?
  sidebar_collapsed     Boolean? @default(false)
  created_at            DateTime
  created_by            String?
  updated_at            DateTime
  updated_by            String?
  is_active             Boolean  @default(true)
  is_deleted            Boolean  @default(false)
  comments              String?

  user users? @relation(fields: [user_id], references: [user_id])

  @@schema("unidesk")
}

model roles {
  role_id     String   @id @db.Uuid
  school_id   String?  @db.Uuid
  name        String
  description String?
  created_at  DateTime
  created_by  String?
  updated_at  DateTime
  updated_by  String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  comments    String?

  school     schools?     @relation(fields: [school_id], references: [school_id])
  user_roles user_roles[]

  @@schema("unidesk")
}

model user_roles {
  user_role_id String @id @db.Uuid
  user_id      String @db.Uuid
  role_id      String @db.Uuid

  is_active  Boolean  @default(true)
  created_at DateTime
  created_by String?
  updated_at DateTime
  updated_by String?
  is_deleted Boolean  @default(false)
  comments   String?

  user users @relation(fields: [user_id], references: [user_id])
  role roles @relation(fields: [role_id], references: [role_id])

  @@unique([user_id, role_id], name: "ux_user_role_per_school")
  @@index([user_id])
  @@index([role_id])
  @@schema("unidesk")
}

model auth_tokens {
  token_id String @id @default(uuid()) @db.Uuid
  user_id  String @db.Uuid

  refresh_token String
  user_agent    String?
  ip_address    String?
  expires_at    DateTime?
  revoked       Boolean   @default(false)
  created_at    DateTime  @default(now())

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@schema("unidesk")
}

model otp {
  otp_id     String   @id @db.Uuid
  otp        String
  user_email String
  expires_at DateTime
  is_expired Boolean  @default(false)
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_email])
  @@schema("unidesk")
}

model FaqCategory {
  faq_id     String    @id @unique @default(uuid())
  name       String
  desc       String
  icon       String
  color      String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  articles   Article[]

  @@schema("unidesk")
}

model FaqTopic {
  topic_id String    @id @unique @default(uuid())
  name     String
  icon     String
  articles Article[]

  @@schema("unidesk")
}

model Article {
  article_id String   @id @default(uuid())
  question   String
  answer     String
  points     String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category_id String
  category    FaqCategory @relation(fields: [category_id], references: [faq_id])

  topic_id String
  topic    FaqTopic @relation(fields: [topic_id], references: [topic_id])

  @@schema("unidesk")
}
