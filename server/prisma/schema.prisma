generator client {
  provider   = "prisma-client-js"
  output     = "../libs/prisma/generated"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  schemas  = ["unidesk"]
}

model unidesk_users {
  user_id    String   @id @db.Uuid
  full_name  String
  email      String   @unique
  role       String
  password   String
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  comments   String?

  @@schema("unidesk")
}

model schools {
  school_id                  String                       @id @db.Uuid
  name                       String
  address                    String?
  phone                      String?
  email                      String
  config                     Json?
  created_at                 DateTime                     @default(now())
  created_by                 String?
  updated_at                 DateTime
  updated_by                 String?
  is_active                  Boolean                      @default(true)
  is_deleted                 Boolean                      @default(false)
  comments                   String?
  established                DateTime?
  school_code                String                       @unique
  website                    String?
  demo_requests              demo_requests[]
  roles                      roles[]
  school_branding            school_branding?
  school_initial_setup       school_initial_setup?
  school_pricing_plans       school_pricing_plans[]
  school_settings            school_settings[]
  school_subscription_status school_subscription_status[]
  users                      users[]

  @@schema("unidesk")
}

model school_subscription_status {
  status_id  String    @id @db.Uuid
  school_id  String    @db.Uuid
  status     String
  valid_from DateTime
  valid_to   DateTime?
  reason     String?
  created_at DateTime  @default(now())
  updated_at DateTime
  comments   String?
  created_by String?
  is_active  Boolean   @default(true)
  is_deleted Boolean   @default(false)
  updated_by String?
  school     schools   @relation(fields: [school_id], references: [school_id])

  @@index([school_id])
  @@schema("unidesk")
}

model school_pricing_plans {
  plan_id         String    @id @db.Uuid
  school_id       String    @db.Uuid
  plan_type       String
  price_per_month Float?
  billing_cycle   String?
  features        Json?
  custom_notes    String?
  valid_from      DateTime
  valid_to        DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime
  comments        String?
  created_by      String?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  updated_by      String?
  school          schools   @relation(fields: [school_id], references: [school_id])

  @@index([school_id])
  @@schema("unidesk")
}

model school_branding {
  branding_id          String   @id @db.Uuid
  school_id            String?  @unique @db.Uuid
  logo_url             String?
  banner_url           String?
  primary_color        String?
  secondary_color      String?
  accent_color         String?
  theme_mode           String?
  login_screen_config  Json?
  header_footer_config Json?
  created_at           DateTime
  created_by           String?
  updated_at           DateTime
  updated_by           String?
  is_active            Boolean  @default(true)
  is_deleted           Boolean  @default(false)
  comments             String?
  school               schools? @relation(fields: [school_id], references: [school_id])

  @@schema("unidesk")
}

model school_settings {
  setting_id  String   @id @db.Uuid
  school_id   String?  @db.Uuid
  category    String?
  key         String?
  value       Json?
  description String?
  created_at  DateTime
  created_by  String?
  updated_at  DateTime
  updated_by  String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  comments    String?
  school      schools? @relation(fields: [school_id], references: [school_id])

  @@unique([school_id, category, key])
  @@schema("unidesk")
}

model school_initial_setup {
  setup_id        String    @id @db.Uuid
  school_id       String    @unique @db.Uuid
  is_completed    Boolean   @default(false)
  steps_completed Json?
  setup_version   Int       @default(1)
  completed_at    DateTime?
  created_at      DateTime
  created_by      String?
  updated_at      DateTime
  updated_by      String?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  comments        String?
  school          schools   @relation(fields: [school_id], references: [school_id], onDelete: Cascade)

  @@schema("unidesk")
}

model demo_requests {
  request_id        String    @id @db.Uuid
  school_id         String?   @db.Uuid
  organization      String
  organization_size String
  full_name         String
  contact_email     String
  contact_phone     String?
  country           String?
  city              String?
  message           String?
  source            String?
  status            String    @default("new")
  scheduled_demo_at DateTime?
  is_active         Boolean   @default(true)
  is_deleted        Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime
  comments          String?
  school            schools?  @relation(fields: [school_id], references: [school_id])

  @@index([contact_email])
  @@index([status])
  @@schema("unidesk")
}

model users {
  user_id                String                  @id @db.Uuid
  school_id              String?                 @db.Uuid
  user_code              String                  @unique
  name                   String?
  email                  String?                @unique
  phone                  String?
  password_hash          String?
  status                 String?
  last_login_at          DateTime?
  profile_photo_url      String?
  config                 Json?
  created_by             String?
  updated_by             String?
  is_active              Boolean                 @default(true)
  is_deleted             Boolean                 @default(false)
  comments               String?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @default(now())
  user_roles             user_roles[]
  school                 schools?                @relation(fields: [school_id], references: [school_id])
  user_preferences       user_preferences?
  user_onboarding_status user_onboarding_status?
  // auth_tokens  auth_tokens[]
  // otp          otp[]
  // activity_logs activity_logs[]
  // doubt_replies doubt_replies[]
  // assignment_comments assignment_comments[]
  // fcm_tokens   fcm_tokens[]
  // notification_logs notification_logs[]
  // presence     presence?
  // messages_sent messages[] @relation("MessageSender")
  // ptm_notes_teacher ptm_notes[] @relation("PTMNotesTeacher")
  // ptm_bookings_parent ptm_bookings[] @relation("PTMParent")
   student_profiles student_profiles?
  teacher_profiles teacher_profiles?
   parent_profiles parent_profiles?
  authTokens             auth_tokens[]

  @@unique([email, school_id])
  @@schema("unidesk")
}

model user_onboarding_status {
  onboarding_id      String    @id @db.Uuid
  user_id            String    @unique @db.Uuid
  has_completed      Boolean   @default(false)
  steps_completed    Json?
  onboarding_version Int?      @default(1)
  first_login_at     DateTime?
  last_prompt_at     DateTime?
  created_at         DateTime
  created_by         String?
  updated_at         DateTime
  updated_by         String?
  is_active          Boolean   @default(true)
  is_deleted         Boolean   @default(false)
  comments           String?
  user               users     @relation(fields: [user_id], references: [user_id])

  @@schema("unidesk")
}

model user_preferences {
  pref_id               String   @id @db.Uuid
  user_id               String   @unique @db.Uuid
  theme                 String?
  language              String?
  dashboard_config      Json?
  shortcuts             Json?
  notification_settings Json?
  default_page          String?
  sidebar_collapsed     Boolean? @default(false)
  created_at            DateTime
  created_by            String?
  updated_at            DateTime
  updated_by            String?
  is_active             Boolean  @default(true)
  is_deleted            Boolean  @default(false)
  comments              String?
  user                  users    @relation(fields: [user_id], references: [user_id])

  @@schema("unidesk")
}

model roles {
  role_id     String       @id @db.Uuid
  school_id   String?      @db.Uuid
  name        String
  description String?
  created_at  DateTime
  created_by  String?
  updated_at  DateTime
  updated_by  String?
  is_active   Boolean      @default(true)
  is_deleted  Boolean      @default(false)
  comments    String?
  school      schools?     @relation(fields: [school_id], references: [school_id])
  user_roles  user_roles[]

  @@schema("unidesk")
}

model user_roles {
  user_role_id String   @id @db.Uuid
  user_id      String   @db.Uuid
  role_id      String   @db.Uuid
  is_active    Boolean  @default(true)
  created_at   DateTime
  created_by   String?
  updated_at   DateTime
  updated_by   String?
  is_deleted   Boolean  @default(false)
  comments     String?
  role         roles    @relation(fields: [role_id], references: [role_id])
  user         users    @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, role_id], name: "ux_user_role_per_school")
  @@index([user_id])
  @@index([role_id])
  @@schema("unidesk")
}

model auth_tokens {
  token_id String @id @default(uuid()) @db.Uuid
  user_id  String @db.Uuid

  refresh_token String
  user_agent    String?
  ip_address    String?
  expires_at    DateTime?
  revoked       Boolean   @default(false)
  created_at    DateTime  @default(now())

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@schema("unidesk")
}

model otp {
  otp_id     String   @id @db.Uuid
  otp        String
  user_email String
  expires_at DateTime
  is_expired Boolean  @default(false)
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_email])
  @@schema("unidesk")
}

model Article {
  article_id  String      @id
  question    String
  answer      String
  points      String[]
  created_at  DateTime    @default(now())
  updated_at  DateTime
  category_id String
  topic_id    String
  FaqCategory FaqCategory @relation(fields: [category_id], references: [faq_id])
  FaqTopic    FaqTopic    @relation(fields: [topic_id], references: [topic_id])

  @@schema("unidesk")
}

model FaqCategory {
  faq_id     String    @id @unique
  name       String
  created_at DateTime  @default(now())
  updated_at DateTime
  desc       String
  icon       String
  color      String
  Article    Article[]

  @@schema("unidesk")
}

model FaqTopic {
  topic_id String    @id @unique
  name     String
  icon     String
  Article  Article[]

  @@schema("unidesk")
}

model student_profiles {
  student_id String @id @default(uuid()) @db.Uuid
  user_id    String @unique @db.Uuid

  admission_no       String
  dob                DateTime
  gender             String?
  blood_group        String?
  emergencyContactNo String?

  class_id   String?
  section_id String?

  comments   String?
  is_deleted Boolean @default(false)

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  student_parent_map student_parent_map[]

  @@schema("unidesk")
}

model parent_profiles {
  parent_id String @id @default(uuid()) @db.Uuid
  user_id   String @unique @db.Uuid

  occupation          String?
  relation_to_student String?
  annual_income       Decimal? @db.Decimal(12, 2)

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?
  is_deleted Boolean  @default(false)
  comments   String?

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  student_parent_map student_parent_map[]

  @@schema("unidesk")
}

model student_parent_map {
  student_parent_map_id String @id @default(uuid()) @db.Uuid
  student_id            String @db.Uuid
  parent_id             String @db.Uuid

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?
  is_deleted Boolean  @default(false)
  comments   String?

  student_profiles student_profiles @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  parent_profiles  parent_profiles  @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)

  @@unique([student_id, parent_id])
  @@schema("unidesk")
}

model teacher_profiles {
  teacher_id String @id @default(uuid()) @db.Uuid
  user_id    String @unique @db.Uuid

  employee_code       String?
  qualification       String?
  joining_date        DateTime?
  experience_in_years Int?

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  is_deleted Boolean @default(false)
  comments   String?

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@schema("unidesk")
}

model classes {
  class_id  String @id @default(uuid()) @db.Uuid
  school_id String @db.Uuid
  year_id   String @db.Uuid

  name String

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  sections sections[]

  @@schema("unidesk")
}

model sections {
  section_id String @id @default(uuid()) @db.Uuid
  class_id   String @db.Uuid

  name String

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt
  updated_by String?  @db.Uuid

  classes classes @relation(fields: [class_id], references: [class_id])

  @@schema("unidesk")
}


model subjects {
  subject_id String @id @default(uuid()) @db.Uuid
  school_id  String @db.Uuid
  year_id    String @db.Uuid

  name     String
  code     String
  category String?

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?

  class_subjects class_subjects[]

  schools         schools         @relation(fields: [school_id], references: [school_id], onDelete: Cascade)
  academic_years  academic_years  @relation(fields: [year_id], references: [year_id], onDelete: Cascade)

  @@unique([school_id, year_id, name])
  @@schema("unidesk")
}

model class_subjects {
  class_subject_id String @id @default(uuid()) @db.Uuid
  class_id         String @db.Uuid
  subject_id       String @db.Uuid

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?

  subjects subjects @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)
  classes  classes  @relation(fields: [class_id], references: [class_id], onDelete: Cascade)

  teacher_subjects teacher_subjects[]

  @@unique([class_id, subject_id])
  @@schema("unidesk")
}

model teacher_subjects {
  teacher_subject_id String @id @default(uuid()) @db.Uuid
  teacher_id         String @db.Uuid
  class_subject_id   String @db.Uuid

  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)
  comments   String?

  created_at DateTime @default(now())
  created_by String?
  updated_at DateTime @updatedAt
  updated_by String?

  teacher_profiles teacher_profiles @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)
  class_subjects   class_subjects   @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)

  @@unique([teacher_id, class_subject_id])
  @@schema("unidesk")
}
