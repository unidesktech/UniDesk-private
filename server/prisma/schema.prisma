model demo_requests {
  request_id        String   @id @db.Uuid
  school_id         String?  @db.Uuid

  organization       String
  organization_size  String
  full_name          String
  contact_email      String
  contact_phone      String?
  country            String?
  city               String?

  message            String?
  source             String?

  status             String   @default("new")

  scheduled_demo_at  DateTime?
  
  is_active          Boolean  @default(true)
  is_deleted         Boolean  @default(false)
  created_at         DateTime
  updated_at         DateTime
  comments           String?

  // Relations
  school schools? @relation(fields: [school_id], references: [school_id])

  @@index([contact_email])
  @@index([status])
}
