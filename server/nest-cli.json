{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps",
  "sourceRoot": "apps",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "dto": {
      "type": "library",
      "root": "libs/dto",
      "entryFile": "index",
      "sourceRoot": "libs/dto/src",
      "compilerOptions": {
        "tsConfigPath": "libs/dto/tsconfig.lib.json"
      }
    },
    "management": {
      "type": "application",
      "root": "apps/student/management",
      "entryFile": "main",
      "sourceRoot": "apps/student/management/src",
      "compilerOptions": {
        "tsConfigPath": "apps/student/management/tsconfig.app.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "request-demo": {
      "type": "application",
      "root": "apps/request-demo",
      "entryFile": "main",
      "sourceRoot": "apps/request-demo/src",
      "compilerOptions": {
        "tsConfigPath": "apps/request-demo/tsconfig.app.json"
      }
    },
    "school": {
      "type": "application",
      "root": "apps/school",
      "entryFile": "main",
      "sourceRoot": "apps/school/src",
      "compilerOptions": {
        "tsConfigPath": "apps/school/tsconfig.app.json"
      }
    },
    "student": {
      "type": "application",
      "root": "apps/management/student",
      "entryFile": "main",
      "sourceRoot": "apps/management/student/src",
      "compilerOptions": {
        "tsConfigPath": "apps/management/student/tsconfig.app.json"
      }
    }
  }
}